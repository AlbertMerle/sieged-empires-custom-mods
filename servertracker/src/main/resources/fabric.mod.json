{
	"schemaVersion": 1,
	"id": "servertracker",
	"version": "${version}",
	"name": "ServerTracker",
	"description": "Server-only dated logs for player chat, joins, leaves, and commands.",
	"authors": [
		"albert"
	],
	"license": "CC0-1.0",
	"environment": "server",
	"entrypoints": {
		"main": [
			{
				"value": "com.servertracker.Servertracker",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"servertracker.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}